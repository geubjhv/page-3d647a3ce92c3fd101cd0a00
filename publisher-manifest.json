          "version": 3,
          "body": "<style>\n  :root {--paper: #f4efe6;--paper-deep: #eae2d3;--ink: #241f1b;--ink-soft: #5c534a;--brick: #b04a2f;--brick-deep: #8c3822;--line: #241f1b}\n  * {box-sizing: border-box}\n  html {}\n  body {margin: 0;background: var(--paper);color: var(--ink);font-family: \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;font-size: 16px;line-height: 1.75;-webkit-font-smoothing: antialiased}\n  a {color: var(--brick-deep);text-decoration: none}\n  a:hover {text-decoration: underline;text-underline-offset: 3px}\n\n  .shell {display: grid;grid-template-columns: 232px minmax(0, 1fr);min-height: 100vh}\n\n  /* 左侧竖排目录 */\n  .rail {position: sticky;top: 0;align-self: start;height: 100vh;padding: 34px 26px 30px 30px;border-right: 2px solid var(--line);background: var(--paper-deep);display: flex;flex-direction: column;gap: 26px}\n  .rail .stamp {display: inline-block;border: 2px solid var(--line);padding: 2px 9px;font-size: 12px;letter-spacing: .22em;text-transform: uppercase}\n  .rail .mark {font-size: 30px;font-weight: 800;letter-spacing: .06em;line-height: 1.1;margin: 0;word-break: break-word}\n  .rail .mark span {display: block;font-size: 13px;font-weight: 500;letter-spacing: .14em;color: var(--ink-soft);margin-top: 8px}\n  .rail nav ol {list-style: none;margin: 0;padding: 0;display: flex;flex-direction: column;gap: 2px;counter-reset: railc}\n  .rail nav li {counter-increment: railc}\n  .rail nav a {display: flex;gap: 10px;align-items: baseline;padding: 8px 0;border-bottom: 1px dashed rgba(36,31,27,.28);color: var(--ink);font-size: 14.5px}\n  .rail nav a::before {content: counter(railc, decimal-leading-zero);font-size: 11px;color: var(--brick);letter-spacing: .08em}\n  .rail nav a:hover {color: var(--brick-deep);text-decoration: none}\n  .rail .rail-note {margin-top: auto;font-size: 12.5px;color: var(--ink-soft);line-height: 1.6;border-top: 2px solid var(--line);padding-top: 14px}\n\n  main {min-width: 0}\n  section {padding: 58px clamp(20px, 5vw, 68px);border-bottom: 2px solid var(--line)}\n  section:last-of-type {border-bottom: 0}\n\n  .eyebrow {display: inline-flex;align-items: center;gap: 10px;font-size: 12px;letter-spacing: .2em;text-transform: uppercase;color: var(--brick-deep);margin: 0 0 16px}\n  .eyebrow::after {content: \"\";width: 44px;height: 2px;background: var(--brick);display: inline-block}\n\n  h2 {font-size: clamp(22px, 3vw, 30px);line-height: 1.3;margin: 0 0 14px;letter-spacing: .01em}\n  h3 {font-size: 17.5px;margin: 0 0 6px;line-height: 1.4}\n  p {margin: 0 0 14px}\n  .lede {color: var(--ink-soft);max-width: 58ch}\n\n  /* 首屏：仪表盘式数据块拼贴 */\n  .hero {padding-top: 52px}\n  .hero h1 {font-size: clamp(46px, 9vw, 104px);line-height: .92;letter-spacing: -0.02em;margin: 0 0 6px;font-weight: 800}\n  .hero h1 .accent {color: var(--brick)}\n  .hero .sub {font-size: clamp(15px, 1.8vw, 18px);color: var(--ink-soft);max-width: 46ch;margin: 0 0 30px}\n  .dash {display: grid;grid-template-columns: repeat(6, 1fr);gap: 14px}\n  .tile {border: 2px solid var(--line);background: var(--paper);padding: 16px 16px 14px;display: flex;flex-direction: column;gap: 6px;min-height: 118px}\n  .tile .lab {font-size: 11.5px;letter-spacing: .16em;text-transform: uppercase;color: var(--ink-soft)}\n  .tile .val {font-size: clamp(22px, 3.2vw, 34px);font-weight: 800;line-height: 1;letter-spacing: -0.01em}\n  .tile .val small {font-size: 13px;font-weight: 600;letter-spacing: 0;margin-left: 3px}\n  .tile .foot {font-size: 12.5px;color: var(--ink-soft);margin-top: auto;line-height: 1.45}\n  .tile.wide {grid-column: span 3}\n  .tile.half {grid-column: span 3}\n  .tile.third {grid-column: span 2}\n  .tile.solid {background: var(--brick);color: #fdf8f0;border-color: var(--brick-deep)}\n  .tile.solid .lab, .tile.solid .foot {color: rgba(253,248,240,.82)}\n  .tile.ink {background: var(--ink);color: #f4efe6}\n  .tile.ink .lab, .tile.ink .foot {color: rgba(244,239,230,.72)}\n\n  /* 使用说明：纵向步骤 */\n  .steps {display: grid;gap: 0;margin-top: 24px}\n  .step {display: grid;grid-template-columns: 88px minmax(0, 1fr);gap: 20px;padding: 22px 0;border-top: 2px solid var(--line);align-items: start}\n  .step:last-child {border-bottom: 2px solid var(--line)}\n  .step .num {font-size: 40px;font-weight: 800;line-height: .9;color: var(--brick)}\n  .step .body p:last-child {margin-bottom: 0}\n  .step .tagline {font-size: 12.5px;color: var(--ink-soft);letter-spacing: .04em}\n\n  /* 套餐：纵向列表逐行展开 */\n  .plans {margin-top: 26px;display: grid;gap: 0}\n  .plan {display: grid;grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr) minmax(0, 0.9fr);gap: 24px;padding: 26px 22px;border: 2px solid var(--line);border-top-width: 0;align-items: start}\n  .plan:first-child {border-top-width: 2px}\n  .plan.featured {background: #fbf6ec;box-shadow: inset 6px 0 0 var(--brick)}\n  .plan .name {display: flex;flex-wrap: wrap;align-items: baseline;gap: 10px}\n  .plan .name h3 {margin: 0;font-size: 21px}\n  .plan .flag {font-size: 11px;letter-spacing: .12em;border: 2px solid var(--brick);color: var(--brick-deep);padding: 1px 7px;text-transform: uppercase}\n  .plan .price {margin-top: 8px;font-size: 27px;font-weight: 800;letter-spacing: -0.01em}\n  .plan .price span {font-size: 13px;font-weight: 500;color: var(--ink-soft);margin-left: 4px;letter-spacing: 0}\n  .plan .annual {font-size: 13px;color: var(--ink-soft);margin-top: 2px}\n  .plan ul {list-style: none;margin: 0;padding: 0;display: grid;gap: 7px}\n  .plan ul li {position: relative;padding-left: 18px;font-size: 14.5px;line-height: 1.6}\n  .plan ul li::before {content: \"\";position: absolute;left: 0;top: .62em;width: 8px;height: 2px;background: var(--brick)}\n  .plan .pick {font-size: 13.5px;color: var(--ink-soft);line-height: 1.6}\n  .plan .pick a {border-bottom: 2px solid var(--brick)}\n  .plan-note {font-size: 13px;color: var(--ink-soft);margin-top: 18px}\n\n  /* 客户端 */\n  .clients {display: grid;grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));gap: 14px;margin-top: 24px}\n  .client {border: 2px solid var(--line);padding: 18px;display: flex;flex-direction: column;gap: 6px;min-height: 150px}\n  .client .plat {font-size: 11.5px;letter-spacing: .16em;text-transform: uppercase;color: var(--ink-soft)}\n  .client h3 {font-size: 17px}\n  .client p {font-size: 14px;margin: 0;color: var(--ink-soft)}\n  .client .avail {margin-top: auto;font-size: 12.5px;border-top: 1px dashed rgba(36,31,27,.3);padding-top: 8px;color: var(--ink-soft)}\n\n  /* FAQ 编号列表 */\n  .faq {margin-top: 24px;display: grid;gap: 0;counter-reset: faq}\n  .faq details {border-top: 2px solid var(--line);padding: 4px 0}\n  .faq details:last-of-type {border-bottom: 2px solid var(--line)}\n  .faq details summary {list-style: none;cursor: pointer;display: grid;grid-template-columns: 56px minmax(0, 1fr);gap: 12px;align-items: baseline;padding: 16px 0;font-size: 16.5px;font-weight: 700}\n  .faq details summary::-webkit-details-marker {display: none}\n  .faq details {counter-increment: faq}\n  .faq details summary::before {content: counter(faq, decimal-leading-zero);font-size: 12.5px;font-weight: 600;letter-spacing: .1em;color: var(--brick)}\n  .faq details summary .q {position: relative}\n  .faq details summary .q::after {content: \"+\";float: right;margin-left: 14px;color: var(--brick);font-weight: 800}\n  .faq details[open] summary .q::after {content: \"–\"}\n  .faq details .a {margin: 0 0 18px 68px;font-size: 14.8px;color: var(--ink-soft);max-width: 62ch}\n  @media (max-width: 700px) {\n    .faq details .a {margin-left: 0}\n  }\n\n  .closing {display: grid;grid-template-columns: minmax(0, 1fr) auto;gap: 24px;align-items: end}\n  .closing .big {font-size: clamp(26px, 4vw, 42px);font-weight: 800;line-height: 1.18;letter-spacing: -0.01em;margin: 0 0 12px}\n  .closing .big em {font-style: normal;color: var(--brick)}\n  .closing .envelope {border: 2px solid var(--line);padding: 14px 18px;font-size: 13px;color: var(--ink-soft);max-width: 260px;line-height: 1.6}\n\n  footer {padding: 26px clamp(20px, 5vw, 68px) 40px;font-size: 12.5px;color: var(--ink-soft);display: flex;flex-wrap: wrap;gap: 8px 20px;justify-content: space-between}\n  footer .brandline {font-weight: 700;color: var(--ink);letter-spacing: .1em}\n\n  @media (max-width: 960px) {\n    .shell {grid-template-columns: 1fr}\n    .rail {position: static;height: auto;border-right: 0;border-bottom: 2px solid var(--line);padding: 22px 20px 18px;gap: 16px}\n    .rail .mark {font-size: 24px}\n    .rail nav ol {flex-direction: row;flex-wrap: wrap;gap: 0 18px}\n    .rail nav a {border-bottom: 0;padding: 4px 0;font-size: 13.5px}\n    .rail .rail-note {margin-top: 4px;font-size: 12px}\n    .dash .tile.wide, .dash .tile.half, .dash .tile.third {grid-column: span 6}\n    .plan {grid-template-columns: 1fr;gap: 16px;padding: 22px 18px}\n    .step {grid-template-columns: 60px minmax(0, 1fr);gap: 14px}\n    .step .num {font-size: 30px}\n    .closing {grid-template-columns: 1fr}\n    .closing .envelope {max-width: none}\n  }\n</style><div class=\"shell\">\n  <aside class=\"rail\">\n    <span class=\"stamp\">Network Desk</span>\n    <p class=\"mark\">work<span>网络工作台</span></p>\n    <nav aria-label=\"页面目录\">\n      <ol>\n        <li><a href=\"#overview\">一眼看清</a></li>\n        <li><a href=\"#howto\">怎么开始</a></li>\n        <li><a href=\"#plans\">套餐逐行</a></li>\n        <li><a href=\"#clients\">客户端</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n        <li><a href=\"#contact\">最后一句</a></li>\n      </ol>\n    </nav>\n    <p class=\"rail-note\">这份页面把能确认的信息都摊开写：价格、权益、客户端状态。没有把握的部分，我们就不写成承诺。</p>\n  </aside>\n\n  <main>\n    <section class=\"hero\" id=\"overview\">\n      <p class=\"eyebrow\">work / 概览</p>\n      <h1>work<span class=\"accent\">，</span><br>把连接当工作来做</h1>\n      <p class=\"sub\">它不是一个按键就消失的黑箱，而是一张能读懂的表：流量、设备数、套餐层级、客户端在哪，都摆在明面上。下面这几块数字，先把家底说清楚。</p>\n\n      <div class=\"dash\">\n        <div class=\"tile wide ink\">\n          <span class=\"lab\">套餐层级</span>\n          <span class=\"val\">3<small>档</small></span>\n          <span class=\"foot\">基础版、旗舰版、团队版，按月或按年，两个节奏都写在价格下面。</span>\n        </div>\n        <div class=\"tile half\">\n          <span class=\"lab\">旗舰版月流量</span>\n          <span class=\"val\">300<small>GB</small></span>\n          <span class=\"foot\">同档支持 5 台设备同时在线。</span>\n        </div>\n        <div class=\"tile half\">\n          <span class=\"lab\">团队版设备上限</span>\n          <span class=\"val\">20<small>台</small></span>\n          <span class=\"foot\">同时在线，另外提供企业定制路由的说明位。</span>\n        </div>\n        <div class=\"tile third solid\">\n          <span class=\"lab\">旗舰版月付</span>\n          <span class=\"val\">¥35</span>\n          <span class=\"foot\">按年付 ¥350/年。</span>\n        </div>\n        <div class=\"tile third\">\n          <span class=\"lab\">基础版起步</span>\n          <span class=\"val\">¥15<small>/月</small></span>\n          <span class=\"foot\">按年付 ¥150/年，每月 100GB。</span>\n        </div>\n        <div class=\"tile third\">\n          <span class=\"lab\">团队版年付</span>\n          <span class=\"val\">¥850<small>/年</small></span>\n          <span class=\"foot\">月付 ¥85/月。</span>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"howto\">\n      <p class=\"eyebrow\">使用说明</p>\n      <h2>四步，从看页面到跑起来</h2>\n      <p class=\"lede\">别急着下单。先确认自己需要多少流量和几台设备，再看套餐，最后找客户端。顺序反了，容易买多或者买少。</p>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"num\">01</div>\n          <div class=\"body\">\n            <h3>先数一下自己的设备</h3>\n            <p>手机、电脑、平板，还有没有挂在后台的备用机。把“同时在线”这个数记下来，它比流量更容易被忽略。基础版 3 台，旗舰版 5 台，团队版 20 台，选少了一台设备就会挤。</p>\n            <p class=\"tagline\">建议：常带出门的两台，加一台家里固定用的，就按 3 台起算。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">02</div>\n          <div class=\"body\">\n            <h3>再看每个月大概用多少</h3>\n            <p>通勤刷视频和在家办公，用量完全不同。100GB、300GB、1000GB 这三档之间差距不小，先按上个月的实际感觉估一遍，宁可选低一档再加，也别一上来就顶到最高。</p>\n            <p class=\"tagline\">页面上只写流量数字，不夸“无限”这类说法。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">03</div>\n          <div class=\"body\">\n            <h3>对号入座看套餐那一节</h3>\n            <p>套餐以纵向列表逐行展开，每一行先读权益再读价格。旗舰版有推荐标记，团队版写了企业定制路由和专属客户经理，如果你不是团队场景，看前两档就够了。</p>\n            <p class=\"tagline\">月付和年付都写在一起，方便你直接比。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">04</div>\n          <div class=\"body\">\n            <h3>找到对的客户端，再动手</h3>\n            <p>客户端那一节按平台分开写，每个平台标明当前状态。没有可靠下载地址的，我们不会硬塞一个链接给你，只写清楚怎么确认。</p>\n            <p class=\"tagline\">这一步慢一点，后面就少一点折腾。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <p class=\"eyebrow\">套餐</p>\n      <h2>三档，逐行往下看</h2>\n      <p class=\"lede\">同一张表里同时给月付和年付，你可以直接横着比。价格和权益都来自页面已确认的信息，没有隐藏项的小字。</p>\n\n      <div class=\"plans\">\n        <div class=\"plan\">\n          <div>\n            <div class=\"name\"><h3>基础版</h3></div>\n            <div class=\"price\">¥15<span>/月</span></div>\n            <div class=\"annual\">按年付仅需 ¥150/年</div>\n          </div>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"pick\">适合一个人、两三台设备、用量不夸张的日常节奏。如果你只是通勤路上用一用，从这一档开始不会错。</p>\n        </div>\n\n        <div class=\"plan featured\">\n          <div>\n            <div class=\"name\"><h3>旗舰版</h3><span class=\"flag\">推荐</span></div>\n            <div class=\"price\">¥35<span>/月</span></div>\n            <div class=\"annual\">按年付仅需 ¥350/年</div>\n          </div>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <p class=\"pick\">三档里权益最均衡的一档：设备数够、流量够、还有优先工单。多人小家庭或者设备多的人，通常停在这里。</p>\n        </div>\n\n        <div class=\"plan\">\n          <div>\n            <div class=\"name\"><h3>团队版</h3></div>\n            <div class=\"price\">¥85<span>/月</span></div>\n            <div class=\"annual\">按年付仅需 ¥850/年</div>\n          </div>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p class=\"pick\">给需要统一安排一批设备的人用。企业定制路由和专属客户经理这两项，建议先和对接人确认清楚再定。</p>\n        </div>\n      </div>\n      <p class=\"plan-note\">以上为页面展示的套餐信息。购买入口与支付方式请以你实际看到的下单页面为准，本页不提供代付或跳转链接。</p>\n    </section>\n\n    <section id=\"clients\">\n      <p class=\"eyebrow\">客户端</p>\n      <h2>客户端按平台拆开说</h2>\n      <p class=\"lede\">有人用电脑，有人只用手机，所以这里不混着写。每个平台单独一块，状态写清楚；暂时没有可靠下载地址的，就直接说实话。</p>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <span class=\"plat\">Desktop</span>\n          <h3>桌面端</h3>\n          <p>适合固定工位、需要长时间挂着连接的场景。安装包与版本号请以下载页实际显示为准。</p>\n          <span class=\"avail\">当前状态：暂未提供官方下载地址</span>\n        </div>\n        <div class=\"client\">\n          <span class=\"plat\">iOS</span>\n          <h3>iOS 端</h3>\n          <p>手机上的日常使用，出门前确认一下同时在线设备数，别把家里那台挤掉。</p>\n          <span class=\"avail\">当前状态：暂未提供官方下载地址</span>\n        </div>\n        <div class=\"client\">\n          <span class=\"plat\">Android</span>\n          <h3>Android 端</h3>\n          <p>与 iOS 类似的使用方式。安装来源请认准你能确认的渠道，不明来源的包不要装。</p>\n          <span class=\"avail\">当前状态：暂未提供官方下载地址</span>\n        </div>\n        <div class=\"client\">\n          <span class=\"plat\">Router</span>\n          <h3>路由器</h3>\n          <p>如果家里设备多，把连接放到路由器上是一种思路；具体是否支持，请以你手上的设备说明为准。</p>\n          <span class=\"avail\">当前状态：支持情况待确认</span>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <p class=\"eyebrow\">常见问题</p>\n      <h2>问得最多的几件事</h2>\n      <p class=\"lede\">按顺序编号，点开看答案。如果这里没有你的问题，先别猜，往下看最后一段。</p>\n\n      <div class=\"faq\">\n        <details>\n          <summary><span class=\"q\">三档套餐里，我应该从哪一档开始？</span></summary>\n          <div class=\"a\">先看设备数，再看流量。只在一两台设备上用，基础版每月 100GB 就够起步；如果家里常有三到五台设备同时在线，旗舰版的 5 台上限和 300GB 更从容；需要统一安排一批设备的，才考虑团队版。</div>\n        </details>\n        <details>\n          <summary><span class=\"q\">年付比月付能省多少？</span></summary>\n          <div class=\"a\">页面上的年付价分别是：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。你可以拿月付价乘以 12 和它直接比，差值就是年付省下的部分。这里只给数字，不给“超值”这类形容词。</div>\n        </details>\n        <details>\n          <summary><span class=\"q\">“同时在线”到底怎么算？</span></summary>\n          <div class=\"a\">就是同一时刻处在连接状态的设备数量。手机、电脑、平板都算一台。基础版 3 台、旗舰版 5 台、团队版 20 台。设备不用时退出，可以腾出名额给另一台。</div>\n        </details>\n        <details>\n          <summary><span class=\"q\">旗舰版里的 IPLC 专线游戏加速优化是什么？</span></summary>\n          <div class=\"a\">这是页面上列出的旗舰版权益之一，写的是面向游戏加速的线路优化。具体的线路表现会受你所在位置、运营商和使用时段影响，本页不做效果承诺，也不列节点数量。</div>\n        </details>\n        <details>\n          <summary><span class=\"q\">团队版的企业定制路由要怎么谈？</span></summary>\n          <div class=\"a\">团队版列出“支持企业定制路由”和“专属客户经理服务”。定制内容需要和对接人逐项确认，包括设备规模、使用场景和期限。本页不代填需求，也不提供报价单。</div>\n        </details>\n        <details>\n          <summary><span class=\"q\">现在能直接下载客户端吗？</span></summary>\n          <div class=\"a\">目前页面上没有可确认的官方下载地址，所以客户端一节统一写成“暂未提供官方下载地址”或“支持情况待确认”。等你从可信渠道拿到明确地址，再安装不迟。遇到来源不明的安装包，直接跳过。</div>\n        </details>\n        <details>\n          <summary><span class=\"q\">流量用超了会怎样？</span></summary>\n          <div class=\"a\">本页只列出各档的每月流量额度，没有关于超出后处理方式的确认信息，所以不在这里替你回答。建议在下单页面或对接渠道确认清楚再决定档位。</div>\n        </details>\n      </div>\n    </section>\n\n    <section id=\"contact\">\n      <div class=\"closing\">\n        <div>\n          <p class=\"eyebrow\">最后一句</p>\n          <p class=\"big\">选套餐这件事，<br>慢一点反而<em>更省心</em>。</p>\n          <p class=\"lede\">先把设备数和用量写在一张纸上，再回来对三行套餐。数字对上了，剩下的就是正常使用。有任何不清楚的，回头再看一遍上面那一节。</p>\n        </div>\n        <div class=\"envelope\">\n          本页为 work 品牌信息展示页，不提供下单、支付或下载入口。价格与权益以页面正文所列内容为准。\n        </div>\n      </div>\n    </section>\n\n    <footer>\n      <span class=\"brandline\">work</span>\n      <span>套餐信息与客户端状态均以本页正文为准</span>\n    </footer>\n  </main>\n</div>",
